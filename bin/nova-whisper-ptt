#!/usr/bin/python3
from pathlib import Path
import os
import sys

here = Path(__file__).resolve()
candidates = [
    Path(os.environ["NOVA_WHISPER_PTT_LIBEXEC"])
    if "NOVA_WHISPER_PTT_LIBEXEC" in os.environ
    else None,
    here.parent.parent / "src",
    here.parent.parent / "libexec" / "nova-whisper-ptt",
]
for candidate in candidates:
    if candidate is not None and (candidate / "nova_whisper_ptt").is_dir():
        sys.path.insert(0, str(candidate))
        break
else:
    raise SystemExit("nova-whisper-ptt Python modules were not found")

from nova_whisper_ptt.cli import main

raise SystemExit(main())
