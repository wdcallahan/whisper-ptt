[Unit]
Description=Nova local Whisper push-to-talk
Documentation=https://github.com/wdcallahan/nova-whisper-ptt
After=graphical-session.target pipewire.service ydotool.service
Wants=pipewire.service
Requires=ydotool.service
PartOf=graphical-session.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
ExecStart={{ nova_whisper_ptt_bin_path }} --config {{ nova_whisper_ptt_config_path }} daemon
Restart=on-failure
RestartSec=2s
TimeoutStopSec=12s
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
